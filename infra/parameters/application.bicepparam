using '../stages/application.bicep'
var config = loadJsonContent('manifest.json')
param location = config.location
param tags = config.tags
param prefix = config.prefix
param environmentName = config.environmentName
param managedEnvironmentName = config.shared.compute.managedEnvironmentName
param registryName = config.shared.compute.registryName
param webIdentityName = config.shared.compute.webIdentityName
param workerIdentityName = config.shared.compute.workerIdentityName
param sqlServerFqdn = '${config.shared.data.serverName}.database.windows.net'
param databaseName = config.shared.data.databaseName
param blobServiceUri = 'https://${config.shared.storage.accountName}.blob.core.windows.net/'
param documentsName = config.shared.storage.documentsName
param keyRingUri = 'https://${config.shared.storage.accountName}.blob.core.windows.net/${config.shared.storage.keysName}/keyring.xml'
param tenantId = config.shared.auth.tenantId
param allowedObjectId = config.shared.auth.allowedObjectId
param webClientId = config.shared.auth.webAppClientId
param deployWorkloads = config.stages.application.parameters.deployWorkloads
param scheduleEnabled = config.stages.application.parameters.scheduleEnabled
param telemetryEnabled = config.stages.application.parameters.telemetryEnabled