@inject IWebHostEnvironment HostEnvironment
@inject IConfiguration Configuration
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>@ViewData["Title"] | Pii</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lucide-static@1.55.0/font/lucide.css" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true" />
</head>
<body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="masthead">
        <a class="brand" asp-page="/Index" aria-label="Pii investment workspace"><span class="brand-mark">pii</span><span>Investment workspace</span></a>
        <span class="private-label"><i class="icon icon-lock-keyhole" aria-hidden="true"></i> Private / informational research</span>
    </header>
    <nav class="navigation" aria-label="Workspace">
        @foreach (var item in new[] { ("/Index", "Brief"), ("/Portfolio", "Portfolio"), ("/Imports", "Imports"), ("/Research", "Research"), ("/Runs", "Runs"), ("/Settings", "Settings") })
        {
            var active = ViewContext.RouteData.Values["page"]?.ToString() == item.Item1;
            <a asp-page="@item.Item1" class="@(active ? "active" : "")" aria-current="@(active ? "page" : null)">@item.Item2</a>
        }
    </nav>
    @if (HostEnvironment.IsDevelopment())
    {
        <aside class="environment-band">Development · @Configuration["Pii:Mode"] · @(Configuration.GetValue<bool>("Pii:AllowDevelopmentIdentity") ? "Loopback-only local identity" : "Entra authentication")</aside>
    }
    <main id="content">@RenderBody()</main>
    <footer>Economic FIFO estimates, not tax advice. Research categories are informational, not instructions or brokerage actions.</footer>
</body>
</html>